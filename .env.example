APP_NAME="Cash Flow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Raised while booting when the server's PHP gives us less; the cash flow
# report and the ERP sync both need more than a default 128M pool.
APP_MEMORY_LIMIT=256M
# What the detached background runs (sync, upgrade) ask for on their own
# command line. Empty leaves the server's CLI setting alone.
SYNC_RUN_MEMORY_LIMIT=512M

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Seconds before a database status check gives up on a connection.
DB_STATUS_TIMEOUT=5

# OMC
DB_OMC_HOST=127.0.0.1
DB_OMC_PORT=5432
DB_OMC_DATABASE=omc
DB_OMC_USERNAME=omc_user
DB_OMC_PASSWORD=secret
DB_OMC_SCHEMA=public
DB_OMC_SSLMODE=prefer
# Local company mirrored from the OMC database (blank = the company whose db_database matches)
OMC_COMPANY_ID=

# ETRIP-VCZ
DB_ETRIP_VCZ_HOST=127.0.0.1
DB_ETRIP_VCZ_PORT=5432
DB_ETRIP_VCZ_DATABASE=etrip_vcz
DB_ETRIP_VCZ_USERNAME=etrip_vcz_user
DB_ETRIP_VCZ_PASSWORD=secret
DB_ETRIP_VCZ_SCHEMA=public
DB_ETRIP_VCZ_SSLMODE=prefer

# ETRIP-CHR
DB_ETRIP_CHR_HOST=127.0.0.1
DB_ETRIP_CHR_PORT=5432
DB_ETRIP_CHR_DATABASE=etrip_chr
DB_ETRIP_CHR_USERNAME=etrip_chr_user
DB_ETRIP_CHR_PASSWORD=secret
DB_ETRIP_CHR_SCHEMA=public
DB_ETRIP_CHR_SSLMODE=prefer

# TINA
DB_TINA_HOST=127.0.0.1
DB_TINA_PORT=3306
DB_TINA_DATABASE=tina
DB_TINA_USERNAME=tina_user
DB_TINA_PASSWORD=secret
# Path to the CA certificate when the server requires TLS (blank = no TLS)
DB_TINA_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Numele cu care se semnează mailurile automate.
MAIL_SENDER_NAME="Receivables & Payables"

# Ce pleacă singur pe e-mail. Gol înseamnă valorile din config/notifications.php.
NOTIFICATIONS_ENABLED=true
# În afara producției: toate mailurile merg la o singură adresă.
NOTIFICATIONS_OVERRIDE_RECIPIENT=
NOTIFICATIONS_CASH_FLOW_ENABLED=true
# Raportul merge la toți userii cu rol Top Management; aici se adaugă alții.
NOTIFICATIONS_CASH_FLOW_TO=
NOTIFICATIONS_CASH_FLOW_HOUR=08:00
NOTIFICATIONS_CASH_FLOW_WEEKDAYS_ONLY=true
NOTIFICATIONS_CASH_FLOW_ATTACH=xlsx
NOTIFICATIONS_DISPUTED_ENABLED=true
NOTIFICATIONS_ROUTED_ENABLED=true

# Repertoriul de contracte: fișierele stau pe discul privat, citirea se face pe server.
CONTRACTS_OCR_ENABLED=true
CONTRACTS_MAX_UPLOAD_MB=50
CONTRACTS_OCR_LANGUAGES=ron+eng
CONTRACTS_ALERTS_ENABLED=true

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT_ID=common

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

EINVOICE_MISMATCH_TOTAL=1
EINVOICE_MISMATCH_VAT=1
